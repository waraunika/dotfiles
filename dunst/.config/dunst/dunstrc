[global]
		monitor = 0
		follow = mouse
		width = (200, 360)
		origin = top-right
		offset = (12, 12)
		gap_size = 4
		corner_radius = 10
		frame_width = 1
		separator_height = 4
		padding = 10
		horizontal_padding = 12

		font = JetBrainsMono Nerd Font Propo 10
		markup = full
		format = "<b>%s</b>\n%b"
		alignment = left
		show_age_threshold = 60

		icon_position = left
		max_icon_size = 40
		enable_recursive_icon_lookup = true

		history_length = 50
		sticky_history = yes
		mouse_left_click = close_current
		mouse_middle_click = do_action, close_current
		mouse_right_click = close_all

		frame_color = "#41484d"
		separator_color = frame


[urgency low]
		background = "#1c2024"
		foreground = "#c1c7ce"
		timeout = 4

[urgency_normal]
		background = "#262b2e"
		foreground = "#dfe3e7"
		frame_color = "#92cef5"
		timeout = 8

[urgency_critical]
		background = "#93000a"
		foreground = "#ffdad6"
		frame_color	= "#ffb4ab"
		timeout = 0

