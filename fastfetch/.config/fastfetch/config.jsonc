{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"display": {
		"separator": " "
	},
	"logo": {
		"type": "kitty-direct",
		"source": "~/.config/fastfetch/cat.png",
		"width": 17,
		"height": 8,
		"padding": {
			"top": 7
		}
	},
	"modules": [
		{
			"type": "custom",
			"key": "╭──── System",
			"keyColor": "blue"
		},
		{
			"type": "os",
			"key": "├─{icon} ->",
			"keyColor": "blue"
		},
		{
			"type": "kernel",
			"key": "├─{icon} ->",
			"keyColor": "blue"
		},
		{
			"type": "datetime",
			"key": "├─{icon} ->",
			"keyColor": "blue"
		},
		{
			"type": "localip",
			"key": "├─{icon} ->",
			"compact": true,
			"keyColor": "blue"
		},
		{
			"type": "uptime",
			"key": "╰─{icon} ->",
			"keyColor": "blue"
		},
		"break",
		{
			"type": "custom",
			"key": "╭─── Hardware",
			"keyColor": "green"
		},
		{
			"type": "host",
			"key": "├─{icon} ->",
			"keyColor": "green"
		},
		{
			"type": "memory",
			"key": "├─{icon} ->",
			"keyColor": "green"
		},
		{
			"type": "swap",
			"key": "├─{icon} ->",
			"keyColor": "green"
		},
		{
			"type": "cpu",
			"key": "├─{icon} ->",
			"keyColor": "green"
		},
		{
			"type": "gpu",
			"key": "├─{icon} ->",
			"keyColor": "yellow"
		},
		{
			"type": "disk",
			"key": "├─{icon} ->",
			"keyColor": "green"
		},
		{
			"type": "de",
			"key": "├─{icon} ->",
			"keyColor": "yellow"
		},
		{
			"type": "wm",
			"key": "├─{icon} ->",
			"keyColor": "yellow"
		},
		{
			"type": "battery",
			"key": "╰─{icon} ->",
			"keyColor": "yellow"
		},
		"break",
		{
			"type": "custom",
			"key": "╭──── Terminal",
			"keyColor": "magenta"
		},
		{
			"type": "shell",
			"key": "├─{icon} ->",
			"keyColor": "magenta"
		},
		{
			"type": "terminal",
			"key": "╰─{icon} ->",
			"keyColor": "magenta"
		}
	]
}
