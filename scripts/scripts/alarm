#!/bin/bash

# Enhanced alarm script with countdown display
ALARM_LOG="$HOME/alarm.log"

# Function to log alarm events
log_alarm() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$ALARM_LOG"
}

# Function to display countdown
show_countdown() {
    local target_hour=$1
    local target_minute=$2
    
    while true; do
        clear
        current_hour=$(date +%H)
        current_minute=$(date +%M)
        current_second=$(date +%S)
        
        current_hour=$((10#$current_hour))
        current_minute=$((10#$current_minute))
        current_second=$((10#$current_second))
        
        if [[ $current_hour -eq $target_hour && $current_minute -eq $target_minute ]]; then
            echo "ALARM TIME!"
            return 0
        fi
        
        # Calculate time remaining
        current_total_minutes=$((current_hour * 60 + current_minute))
        target_total_minutes=$((target_hour * 60 + target_minute))
        
        if [[ $target_total_minutes -lt $current_total_minutes ]]; then
            # Alarm is for tomorrow
            target_total_minutes=$((target_total_minutes + 24 * 60))
        fi
        
        minutes_remaining=$((target_total_minutes - current_total_minutes - 1))
        seconds_remaining=$((60 - current_second))
        
        if [[ $seconds_remaining -eq 60 ]]; then
            seconds_remaining=0
            minutes_remaining=$((minutes_remaining + 1))
        fi
        
        echo "Alarm set for: $(printf "%02d:%02d" $target_hour $target_minute)"
        echo "Current time:   $(printf "%02d:%02d:%02d" $current_hour $current_minute $current_second)"
        echo "Time remaining: $(printf "%02d:%02d" $minutes_remaining $seconds_remaining)"
        echo ""
        echo "Press Ctrl+C to cancel alarm"
        
        sleep 1
    done
}

# Main function
set_alarm() {
    echo "╔══════════════════════════════════╗"
    echo "║        BASH ALARM CLOCK          ║"
    echo "╚══════════════════════════════════╝"
    echo ""
    
    if [[ $# -eq 1 ]]; then
        alarm_time="$1"
    else
        echo "Enter alarm time (HH:MM, 24-hour format):"
        read alarm_time
    fi
    
    # Validate input
    if [[ ! $alarm_time =~ ^([0-9]{2}):([0-9]{2})$ ]]; then
        echo "❌ Invalid format. Use HH:MM"
        exit 1
    fi
    
    alarm_hour=$(echo "$alarm_time" | cut -d: -f1)
    alarm_minute=$(echo "$alarm_time" | cut -d: -f2)
    
    alarm_hour=$((10#$alarm_hour))
    alarm_minute=$((10#$alarm_minute))
    
    if [[ $alarm_hour -gt 23 || $alarm_minute -gt 59 ]]; then
        echo "❌ Invalid time"
        exit 1
    fi
    
    log_alarm "Alarm set for $(printf "%02d:%02d" $alarm_hour $alarm_minute)"
    
    # Show countdown
    show_countdown $alarm_hour $alarm_minute
    
    # Trigger alarm
    echo "🔔 ALARM! 🔔"
    echo "Time: $(date +%H:%M:%S)"
    
    log_alarm "Alarm triggered"
    
    # Play alarm
    for i in {1..20}; do
        echo -e '\a'
        echo "Alarm ringing... Press Ctrl+C to stop"
        sleep 1
    done
}

# Handle script termination
cleanup() {
    echo ""
    echo "Alarm cancelled"
    log_alarm "Alarm cancelled by user"
    exit 0
}

trap cleanup SIGINT SIGTERM

# Run the script
if [[ $# -eq 1 ]]; then
    set_alarm "$1"
else
    set_alarm
fi
